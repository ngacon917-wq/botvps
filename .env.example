# ========================================================
# DISCORD LXC VPS MANAGER BOT - CẤU HÌNH DUY NHẤT CẦN THIẾT
# ========================================================

# 1. Token bot Discord (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Discord User ID của CHỦ SỞ HỮU DUY NHẤT (Master Owner)
# (Chuột phải vào avatar Discord của bạn -> Copy User ID)
OWNER_DISCORD_ID=your_discord_user_id_here

# 3. Slash commands: đăng ký trong server này (Copy Server ID).
# Bỏ trống để đăng ký toàn cục. Không cần DISCORD_CLIENT_ID để tự đăng ký.
DISCORD_GUILD_ID=

# 4. Chỉ bật nếu vẫn muốn dùng lệnh prefix cũ (cần Message Content Intent).
ENABLE_PREFIX_COMMANDS=false
# Tiền tố lệnh cũ
PREFIX=?

# ========================================================
# TỰ ĐỘNG HÓA HOÀN TOÀN (ZERO-CONFIG / KHÔNG BẮT BUỘC ĐIỀN)
# ========================================================
# • Database: Hệ thống tự động kết nối PostgreSQL cục bộ qua Unix Socket.
# • Agent Token: Hệ thống tự động tạo mã bảo mật nội bộ an toàn 256-bit.
# • Toàn bộ container, file và backup đều tự động lưu tại /var/lib/lxc và /var/lib/vpsbot.

# Local setup-db.sh configures peer authentication for root (the systemd service user).
# For another OS user or a remote database, set DATABASE_URL or PGUSER/PGPASSWORD.
# DATABASE_URL=postgresql://vpsbot:password@127.0.0.1:5432/vpsbot
# Set false when a separate vpsbot-agent service owns the agent port.
EMBEDDED_AGENT=true
# Bind address for the agent. Use a reachable address for remote worker nodes.
AGENT_HOST=127.0.0.1
AGENT_PORT=4000
# NODE_ID=node-1
# AGENT_API_TOKEN=replace_with_a_shared_secret
