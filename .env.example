# ========================================================
# DISCORD LXC VPS MANAGER BOT - CẤU HÌNH DUY NHẤT CẦN THIẾT
# ========================================================

# 1. Token bot Discord (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Discord User ID của CHỦ SỞ HỮU DUY NHẤT (Master Owner)
# (Chuột phải vào avatar Discord của bạn -> Copy User ID)
OWNER_DISCORD_ID=your_discord_user_id_here

# 3. Tiền tố lệnh (Mặc định: ?)
PREFIX=?

# ========================================================
# TỰ ĐỘNG HÓA HOÀN TOÀN (ZERO-CONFIG / KHÔNG BẮT BUỘC ĐIỀN)
# ========================================================
# • Database: Hệ thống tự động kết nối PostgreSQL cục bộ qua Unix Socket.
# • Agent Token: Hệ thống tự động tạo mã bảo mật nội bộ an toàn 64-bit.
# • Toàn bộ container, file và backup đều tự động lưu tại /var/lib/lxc và /var/lib/vpsbot.
